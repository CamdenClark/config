// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j k": ["workspace::SendKeystrokes", "escape"]
    }
  },
  {
    "context": "Editor && vim_mode == normal || ProjectPanel",
    "bindings": {
      "space f": "workspace::NewSearch",
      "space p": "file_finder::Toggle",
      "space space": "command_palette::Toggle",
      "space a": "assistant::ToggleFocus",
      "H": "pane::ActivatePrevItem",
      "L": "pane::ActivateNextItem",
      "space w n": ["workspace::ActivatePaneInDirection", "Right"],
      "space i": "assistant::InlineAssist",
      "space s": "assistant::Assist",
      "space w p": ["workspace::ActivatePaneInDirection", "Left"],
      "space t": "workspace::NewTerminal",
      "space n": "workspace::NewFile",
      "space b d": "pane::CloseActiveItem",

      ", c a": "editor::ToggleCodeActions",

      // REPL
      ", e e": "repl::Run",
      ", e c": "repl::ClearOutputs",
      ", e r": "repl::Restart",

      ", t a": ["task::Spawn", { "task_name": "test all" }],
      ", t t": ["task::Spawn", { "task_name": "test file" }],

      // Git
      "space g b": ["task::Spawn", { "task_name": "gbrowse" }],
      "space g g": ["task::Spawn", { "task_name": "lazygit" }],

      // Meta items...
      "space q k": "zed::OpenKeymap",
      "space q c": "zed::OpenSettings",
      "space q t": "zed::OpenTasks",
      "space q p": "assistant::DeployPromptLibrary"
    }
  },
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "space a": "assistant::InlineAssist",
      ", e": "repl::RunInPlace"
    }
  }
  /*
  {
    "context": "Dock",
    "bindings": {
      "space w n": ["workspace::ActivatePaneInDirection", "Right"],
      "space w p": ["workspace::ActivatePaneInDirection", "Left"]
    }
  }
  */
]

// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette
{
  "cli_default_open_behavior": "new_window",
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    }
  },
  "context_servers": {
    "surfboard": {
      "enabled": true,
      "url": "https://app.surfboard.ai/mcp/"
    }
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "edit_predictions": {
    "provider": "zed"
  },
  "agent": {
    "dock": "left",
    "favorite_models": [],
    "model_parameters": [],
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "zed.dev",
      "model": "claude-sonnet-4-6"
    },
  },
  "cursor_blink": false,
  "lsp": {
    "pyright": {
      "settings": {
        "python": {
          "pythonPath": ".venv/bin/python"
        }
      }
    }
  },
  "languages": {
    "Markdown": {
      "show_edit_predictions": false
    },
    "Clojure": {
      "tab_size": 2,
      "formatter": {
        "external": {
          "command": "cljstyle",
          "arguments": ["pipe"]
        }
      }
    }
  },
  "relative_line_numbers": "enabled",
  "soft_wrap": "bounded",
  "scrollbar": { "show": "never" },
  "scroll_beyond_last_line": "off",
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 14.0,
  "command_aliases": {
    "W": "w",
    "Wq": "wq",
    "Q": "q"
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Catppuccin Latte"
  },
  "language_models": {
    "openai": {
      "api_url": "http://localhost:4000",
      "available_models": [{ "name": "gpt-4o-foo", "max_tokens": 128000 }]
    }
  }
}

#!/bin/bash

# Calculate most recent Monday's date
today=$(date +%Y-%m-%d)

# Name of the new file
filename="$NOTES/Daily/${today}.md"

# Check if file doesn't exist
if [ ! -f "$filename" ]
then
    # Copy the template to the new file
    cp "$NOTES/Templates/Daily Check-in.md" "$filename"
fi

# Open the new file in neovim
nvim "$filename"
exit 0
